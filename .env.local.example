# Circle W3S API keys — must match NEXT_PUBLIC_NETWORK (see below).
# TEST keys (prefix TEST_API_KEY:) — use with testnet / ARC-TESTNET wallets.
CIRCLE_API_KEY=<YOUR_CIRCLE_TEST_API_KEY>
# LIVE keys (prefix LIVE_API_KEY:) — required for mainnet / ARC wallets.
# Circle rejects TEST keys for mainnet blockchains (error 156006).
CIRCLE_API_KEY_LIVE=<YOUR_CIRCLE_LIVE_API_KEY>

# Circle Programmable Wallets App ID (public) — testnet vs mainnet.
NEXT_PUBLIC_CIRCLE_APP_ID=<YOUR_CIRCLE_TESTNET_APP_ID>
NEXT_PUBLIC_CIRCLE_APP_ID_LIVE=<YOUR_CIRCLE_MAINNET_APP_ID>

# Google OAuth Web client ID (public) — testnet vs mainnet projects/clients.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_TESTNET_OAUTH_CLIENT_ID>
NEXT_PUBLIC_GOOGLE_CLIENT_ID_LIVE=<YOUR_GOOGLE_MAINNET_OAUTH_CLIENT_ID>

# --- Network ---
# testnet (default) | mainnet
# NEXT_PUBLIC_NETWORK=testnet
# Optional Arc RPC override (defaults: testnet rpc.testnet.arc.network / mainnet rpc.arc.network)
# NEXT_PUBLIC_ARC_RPC_URL=<YOUR_ARC_RPC_URL>

# --- Swap / Bridge (Circle App Kit) ---
# Required: Vector platform fee recipient (public address — not secret).
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=0xfa7356ee40fec13c748e190dc857c11c67c9ab6d

# Optional Circle App Kit key for swap attribution / higher rate limits.
# NEXT_PUBLIC_KIT_KEY=<YOUR_CIRCLE_KIT_KEY>

# Optional WalletConnect (Reown) project ID — verified dApp metadata; can improve OKX/Mobile wallet trust.
# Create at https://cloud.reown.com/
# NEXT_PUBLIC_WC_PROJECT_ID=

# --- Testnet faucet (ignored on mainnet) ---
# NEXT_PUBLIC_ARC_FAUCET_URL=https://faucet.circle.com

# --- Send router (Vector's own contract on Arc) ---
# NEXT_PUBLIC_VECTOR_ROUTER_ARC=<YOUR_DEPLOYED_ROUTER_ADDRESS>

# --- POST /api/endpoints abuse controls (server-only) ---
# Comma-separated origins allowed to call the Circle proxy (browser Origin/Referer).
# ALLOWED_ORIGINS=https://vectorprotocol.pro,https://www.vectorprotocol.pro,http://localhost:3000
# Per-IP sliding window limits (requests per 60s, in-memory per serverless instance).
# Override in Vercel → Project → Settings → Environment Variables (Production + Preview as needed).
# RATE_LIMIT_DEVICE_PER_MINUTE=10
# Kit bucket: swap/earn/bridge + contractExecution challenges. Default in code is 20/min;
# production should use 40/min so deposit+withdraw+swap+bridge in one minute has headroom.
# RATE_LIMIT_KIT_PER_MINUTE=40
# Extra Arc contracts allowed for Google-wallet contractExecution (comma-separated).
# W3S_ALLOWED_CONTRACTS=0x...
# RATE_LIMIT_DEFAULT_PER_MINUTE=30
